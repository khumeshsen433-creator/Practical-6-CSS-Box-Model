<!DOCTYPE html>
<html>
<head>
    <title>CSS Box Model</title>

    <style>
        body {
            font-family: Arial, sans-serif;
        }

        .box1 {
            width: 200px;
            padding: 20px;
            border: 5px solid blue;
            margin: 30px;
            background-color: lightblue;
            box-sizing: content-box;
        }

        .box2 {
            width: 200px;
            padding: 20px;
            border: 5px solid red;
            margin: 30px;
            background-color: pink;
            box-sizing: border-box;
        }
    </style>
</head>
<body>

    <h1>CSS Box Model</h1>

    <div class="box1">
        Content Box
    </div>

    <div class="box2">
        Border Box
    </div>

</body>
</html>